# Base URL of the Cardo API (Express), reachable from both the server and the browser.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Used to build absolute canonical/Open Graph/hreflang URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Site-wide sign-in gate (blocks the entire site, /admin included, behind a
# single login) — for a private pre-launch preview. Never exposed to the
# client; used only in middleware.ts and the /api/gate route handler.
SITE_GATE_EMAIL="you@example.com"
SITE_GATE_PASSWORD="change-me"
# Random secret used as the session cookie's value. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_GATE_TOKEN="change-me-too"
