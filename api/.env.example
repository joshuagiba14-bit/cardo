# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://cardo:cardo@localhost:5432/cardo?schema=public"

# Port the Express server listens on.
PORT=4000

# Origin allowed by CORS (the Next.js app). Comma-separate for multiple origins.
CORS_ORIGIN="http://localhost:3000"

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# How long an admin session stays valid.
JWT_EXPIRES_IN="8h"

# "development" | "production" | "test"
NODE_ENV="development"
