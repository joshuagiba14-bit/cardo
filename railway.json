{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run prisma:generate --workspace=api"
  },
  "deploy": {
    "startCommand": "npm run db:migrate:deploy --workspace=api && npm run start --workspace=api",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
