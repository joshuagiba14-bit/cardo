# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never put real keys in this file or in code.
# Variables starting with NEXT_PUBLIC_ are visible in the browser:
# never put a secret in one.

# --- App (Phase 0) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Global AI kill switch. Set to "false" to turn off every AI feature.
AI_ENABLED=true

# --- Supabase (Phase 1) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only, never in client code

# --- Anthropic (Phase 2) ---
# ANTHROPIC_API_KEY=

# --- Upstash Redis rate limiting (Phase 2) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (Phase 5) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ESSENTIEL=
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_MAX=

# --- Resend email (Phase 6) ---
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Vercel Cron (Phase 6) ---
# CRON_SECRET=

# --- Admin (Phase 5) ---
# ADMIN_EMAILS=                     # comma-separated

# --- Sentry (Phase 8) ---
# SENTRY_DSN=
